{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "strict": false,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["server.ts"],
  "exclude": ["node_modules", "dist", "project-manager", "get-folders.ts", "list-agents.ts"]
}
