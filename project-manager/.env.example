# Salesforce Credentials (Read-Only Access)
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=your_sf_username
SF_PASSWORD=your_sf_password
SF_SECURITY_TOKEN=your_sf_security_token

# Optional: Required only if your org enforces Connected App
# REQUIRED for SSO/Azure AD orgs — create a Connected App in Salesforce
# Callback URL must be: http://localhost:3456/callback
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
